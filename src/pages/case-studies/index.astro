---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../data/site';
import { caseStudies } from '../../data/case-studies';
import { organizationSchema } from '../../data/seo';

const jsonLd = [
  organizationSchema(),
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: `${site.name} case studies`,
    numberOfItems: caseStudies.length,
    itemListElement: caseStudies.map((c, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: `${c.client} case study`,
      item: new URL(`/case-studies/${c.slug}/`, site.url).toString(),
    })),
  },
];
---

<BaseLayout
  title="Case Studies | Badger Automation Group"
  description="Real results from Badger Automation Group clients in southeastern Wisconsin: verified leads, Google reviews, and local search growth for home services businesses."
  keywords="local SEO case study, HVAC marketing case study, Milwaukee home services marketing results, Wisconsin website leads"
  jsonLd={jsonLd}
>
  <div class="border-b border-badger/8 bg-gradient-to-b from-paper to-paper-dim">
    <div class="mx-auto max-w-6xl px-4 py-16 md:px-6 md:py-24">
      <p class="text-[11px] font-bold uppercase tracking-[0.22em] text-badger/45">Case studies</p>
      <h1 class="mt-4 max-w-3xl font-display text-4xl font-semibold text-ink md:text-5xl">
        Results from local businesses we work with
      </h1>
      <p class="mt-6 max-w-2xl text-lg text-badger/75">
        Verified numbers only: real form submissions, public Google reviews, and analytics we can show you on a call.
      </p>
    </div>
  </div>

  <div class="mx-auto max-w-6xl px-4 py-16 md:px-6 md:py-20">
    <ul class="grid gap-6">
      {
        caseStudies.map((c) => (
          <li>
            <a
              href={`/case-studies/${c.slug}/`}
              class="group block rounded-2xl border border-badger/10 bg-white p-6 shadow-card transition hover:shadow-card-hover md:p-8"
            >
              <p class="text-[11px] font-bold uppercase tracking-[0.2em] text-badger/50">
                {c.industry} · {c.location}
              </p>
              <h2 class="mt-3 font-display text-2xl font-semibold text-ink md:text-3xl">{c.client}</h2>
              <p class="mt-3 max-w-3xl text-badger/75">{c.headline}</p>
              <dl class="mt-6 grid grid-cols-2 gap-4 md:grid-cols-4">
                {c.heroMetrics.map((m) => (
                  <div class="rounded-xl bg-paper p-4">
                    <dt class="text-xs font-medium text-badger/60">{m.label}</dt>
                    <dd class="mt-1 font-display text-3xl font-bold text-badger">{m.value}</dd>
                  </div>
                ))}
              </dl>
              <span class="mt-6 inline-flex items-center gap-1 text-sm font-semibold text-badger group-hover:underline">
                Read the case study →
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>

  <section class="border-t border-badger/8 bg-badger py-16 text-paper md:py-20">
    <div class="mx-auto flex max-w-6xl flex-col items-start gap-6 px-4 md:flex-row md:items-center md:justify-between md:px-6">
      <div>
        <h2 class="font-display text-2xl font-semibold md:text-3xl">Want numbers like these?</h2>
        <p class="mt-2 text-paper/75">We will look at your site, your Google profile, and where your leads come from today.</p>
      </div>
      <a
        href="/contact/"
        class="inline-flex items-center rounded-full bg-white px-6 py-3 text-sm font-bold uppercase tracking-wider text-[#1a0000] transition hover:bg-white/90"
      >
        Book a call
      </a>
    </div>
  </section>
</BaseLayout>
